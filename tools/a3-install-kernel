#!/bin/bash
# a3-install-kernel: copy the current kernel build into /boot on the running phone,
# so our U-Boot boots it from the eMMC (sysboot mmc 0:13 /boot/extlinux/extlinux.conf).
#
#   a3-install-kernel [--no-prev]
#   a3-install-kernel --stage DIR    write the same /boot set into a local DIR (build-rootfs)
#
# File copies over ssh onto the mounted rootfs only: no partition writes.
# The installed set before this one is kept as *.prev and booted by
# extlinux-prev.conf ("Boot Previous Kernel" in the Volume Down menu).
# --no-prev  overwrite without keeping the old set (first install, or a bad .prev).
#
# Only install kernels that already booted fine from RAM (fastboot boot).
set -euo pipefail
ROOT=~/Projects/exynos7870
O=$ROOT/out/linux
IMAGE=$O/arch/arm64/boot/Image
DTB=$O/arch/arm64/boot/dts/exynos/exynos7870-a3y17lte.dtb
INITRD=$ROOT/out/images/initramfs-debug-system.cpio.gz
KEEP_PREV=1 LOCAL=""
[[ "${1:-}" == --no-prev ]] && { KEEP_PREV=0; shift; }
[[ "${1:-}" == --stage ]] && { LOCAL=${2:?--stage needs a directory}; shift 2; }
for f in "$IMAGE" "$DTB" "$INITRD"; do [ -s "$f" ] || { echo "missing $f" >&2; exit 1; }; done
REL=$(cat "$O/include/config/kernel.release")

conf() {	# conf SUFFIX LABEL
	cat <<EOF
# Generated by a3-install-kernel. The kernel forces its own command line.
default a3
timeout 0
label a3
	menu label $2
	kernel /boot/Image$1
	fdt /boot/a3y17lte.dtb$1
	initrd /boot/initramfs.gz$1
EOF
}

if [ -n "$LOCAL" ]; then
	mkdir -p "$LOCAL/extlinux"
	install -m644 "$IMAGE" "$LOCAL/Image"
	install -m644 "$DTB" "$LOCAL/a3y17lte.dtb"
	install -m644 "$INITRD" "$LOCAL/initramfs.gz"
	echo "$REL $(date -Is)" > "$LOCAL/release"
	conf "" "current" > "$LOCAL/extlinux/extlinux.conf"
	exit 0
fi

SSH=(ssh -o ConnectTimeout=5 a3)
STAGE=/boot/.new

"${SSH[@]}" "rm -rf $STAGE && mkdir -p $STAGE /boot/extlinux"
for f in "$IMAGE:Image" "$DTB:a3y17lte.dtb" "$INITRD:initramfs.gz"; do
	src=${f%%:*} dst=${f##*:}
	"${SSH[@]}" "cat > $STAGE/$dst" < "$src"
	want=$(sha256sum < "$src" | cut -d' ' -f1)
	got=$("${SSH[@]}" "sha256sum < $STAGE/$dst" | cut -d' ' -f1)
	[ "$want" = "$got" ] || { echo "checksum mismatch on $dst" >&2; exit 1; }
done
echo "$REL $(date -Is)" | "${SSH[@]}" "cat > $STAGE/release"

conf "" "current" | "${SSH[@]}" "cat > /boot/extlinux/extlinux.conf.new"
conf ".prev" "previous" | "${SSH[@]}" "cat > /boot/extlinux/extlinux-prev.conf.new"

"${SSH[@]}" "set -e; cd /boot
	if [ $KEEP_PREV = 1 ] && [ -f Image ]; then
		for f in Image a3y17lte.dtb initramfs.gz release; do [ -f \$f ] && mv -f \$f \$f.prev; done
	fi
	for f in Image a3y17lte.dtb initramfs.gz release; do mv -f .new/\$f \$f; done
	rmdir .new
	mv -f extlinux/extlinux.conf.new extlinux/extlinux.conf
	if [ -f Image.prev ]; then mv -f extlinux/extlinux-prev.conf.new extlinux/extlinux-prev.conf
	else rm -f extlinux/extlinux-prev.conf.new; fi
	sync
	ls -l /boot /boot/extlinux; echo; cat release; [ -f release.prev ] && cat release.prev || true"
