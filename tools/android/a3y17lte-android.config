# a3y17lte on Android, on top of work/config-a3y17lte (the mainline/Alpine config) and the
# Android requirement fragments.

CONFIG_LOCALVERSION="-a3y17lte-android"

# S-Boot passes androidboot.* on the cmdline: take it as is. Our own parameters come from the
# bootconfig appended to the ramdisk (device tree bootconfig.txt).
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set
CONFIG_BOOT_CONFIG=y
CONFIG_BOOT_CONFIG_FORCE=y

# First-stage mount: everything built in (no modules in the boot ramdisk)
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
# ACK's f2fs vendor hooks need it (as in gki_defconfig)
CONFIG_F2FS_UNFAIR_RWSEM=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_FS_VERITY=y

# zram swap (2 GB RAM); lz4 as in the device init
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# dma-buf system heap: minigbm allocates non-scanout buffers from it, Codec2 its buffers
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# USB gadget for adb/MTP/tethering through configfs + FunctionFS
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_MIDI=y

# Android userspace scheduling
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MISC=y

# Requirements whose symbols moved in 6.18 (android-base.config is the 6.12 list):
# iptables legacy is gated since 6.17, CFI_CLANG is now CFI; IFB needs an action,
# HID_PLAYSTATION multicolour LEDs. Not taken: ASHMEM (Rust-only in ACK 6.18; Android uses
# memfd), SCHED_DEBUG and NF_CT_PROTO_DCCP (removed upstream), USB_CONFIGFS_F_ACC (gone).
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_CFI=y

# Size: BOOT is 32 MiB for an uncompressed Image + ramdisk + dt.img (S-Boot cannot
# decompress), so the Image stays under 24 MiB. Things the Alpine/pmOS config builds in that
# Android does not use. KVM is useless anyway: S-Boot enters the kernel at EL1.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ETHERNET is not set
# CONFIG_KALLSYMS_ALL is not set
