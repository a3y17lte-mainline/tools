# a3y17lte on Android, on top of work/config-a3y17lte (the mainline/Alpine config) and the
# Android requirement fragments.

CONFIG_LOCALVERSION="-a3y17lte-android"

# S-Boot passes androidboot.* on the cmdline: take it as is. Our own parameters come from the
# bootconfig appended to the ramdisk (device tree bootconfig.txt).
CONFIG_CMDLINE=""
# CONFIG_CMDLINE_FORCE is not set
CONFIG_BOOT_CONFIG=y
CONFIG_BOOT_CONFIG_FORCE=y

# First-stage mount: everything built in (no modules in the boot ramdisk)
CONFIG_BLK_DEV_DM=y
CONFIG_DM_VERITY=y
CONFIG_EROFS_FS=y
CONFIG_EROFS_FS_ZIP=y
CONFIG_EROFS_FS_XATTR=y
CONFIG_EROFS_FS_SECURITY=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_SECURITY=y
CONFIG_F2FS_FS_COMPRESSION=y
CONFIG_F2FS_FS_LZ4=y
# ACK's f2fs vendor hooks need it (as in gki_defconfig)
CONFIG_F2FS_UNFAIR_RWSEM=y
CONFIG_FS_ENCRYPTION=y
CONFIG_FS_ENCRYPTION_ALGS=y
CONFIG_FS_VERITY=y

# zram swap (2 GB RAM); lz4 as in the device init
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_DEF_COMP_LZ4=y

# dma-buf system heap: minigbm allocates non-scanout buffers from it, Codec2 its buffers
CONFIG_DMABUF_HEAPS=y
CONFIG_DMABUF_HEAPS_SYSTEM=y

# USB gadget for adb/MTP/tethering through configfs + FunctionFS
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_F_FS=y
CONFIG_USB_CONFIGFS_NCM=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_MIDI=y

# From ACK's gki_defconfig, found missing at the first Android boot (2026-11-15):
# cpuset is a cgroup v1 controller in Android's cgroups.json, gated since 6.12
# ("cgroup: Unknown subsys name 'cpuset'"); FUSE passthrough for MediaProvider and adb
# incremental installs; named anonymous mappings (ART, libc); multi-gen LRU as in GKI (2 GB
# RAM); utf8 for vfat/exfat SD cards mounted by vold.
CONFIG_CPUSETS_V1=y
CONFIG_FUSE_BPF=y
CONFIG_INCREMENTAL_FS=y
CONFIG_ANON_VMA_NAME=y
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
CONFIG_NLS_UTF8=y

# No text console on the panel (as in GKI): fbcon showed a blinking cursor from DRM bind until
# SurfaceFlinger, and the fbdev emulation's modeset would blank the S-Boot logo. Recovery and
# SurfaceFlinger use DRM directly.
# CONFIG_VT is not set
# CONFIG_FRAMEBUFFER_CONSOLE is not set
# CONFIG_DRM_FBDEV_EMULATION is not set

# Android userspace scheduling
CONFIG_CPU_FREQ_DEFAULT_GOV_SCHEDUTIL=y
CONFIG_UHID=y
CONFIG_INPUT_UINPUT=y
CONFIG_INPUT_MISC=y

# Requirements whose symbols moved in 6.18 (android-base.config is the 6.12 list):
# iptables legacy is gated since 6.17, CFI_CLANG is now CFI; IFB needs an action,
# HID_PLAYSTATION multicolour LEDs. ASHMEM (from android-base.config) is the C driver of our
# ANDROID: patch (ACK 6.18 has only the Rust one). Not taken: SCHED_DEBUG and NF_CT_PROTO_DCCP
# (removed upstream), USB_CONFIGFS_F_ACC (gone).
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NETFILTER_XTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES_LEGACY=y
CONFIG_IP6_NF_IPTABLES_LEGACY=y
CONFIG_IP_NF_IPTABLES=y
CONFIG_IP6_NF_IPTABLES=y
CONFIG_NET_SCHED=y
CONFIG_NET_CLS_ACT=y
CONFIG_NET_ACT_MIRRED=y
CONFIG_LEDS_CLASS_MULTICOLOR=y
CONFIG_CFI=y

# Size: BOOT is 32 MiB for an uncompressed Image + ramdisk + dt.img (S-Boot cannot
# decompress), so the Image stays under 24 MiB. Things the Alpine/pmOS config builds in that
# Android does not use. KVM is useless anyway: S-Boot enters the kernel at EL1.
# CONFIG_VIRTUALIZATION is not set
# CONFIG_KVM is not set
# CONFIG_BTRFS_FS is not set
# CONFIG_XFS_FS is not set
# CONFIG_UDF_FS is not set
# CONFIG_SQUASHFS is not set
# CONFIG_ETHERNET is not set
# CONFIG_KALLSYMS_ALL is not set

# NFC: Android's stack (libnfc-nci) is the NCI host, so the S3NRN80 is a raw NCI character
# device (/dev/s3fwrn5, ANDROID: patch) instead of a device of the kernel's NCI core
CONFIG_NFC_S3FWRN5_RAW=y

# SELinux must be in the LSM list, or it is compiled in but never initialised: no selinuxfs,
# and Android's first-stage init aborts. The Alpine config's list has no selinux.
CONFIG_LSM="landlock,lockdown,yama,loadpin,safesetid,selinux,bpf"

# With SELinux, a filesystem without security xattrs cannot be mounted (EOPNOTSUPP): ext4 is
# /cache and /metadata. (f2fs and erofs have theirs above.)
CONFIG_EXT4_FS_SECURITY=y

# f2fs casefolding: Android formats /data with casefold + project quota for emulated storage
# (emulated_storage.mk); without the Unicode tables the kernel cannot mount it
CONFIG_UNICODE=y

# No compressed modules: the Android build may not run zstd (PATH tools restriction), so
# modules_install failed, and Android's module loader (libmodprobe) loads plain .ko files
# CONFIG_MODULE_COMPRESS is not set
