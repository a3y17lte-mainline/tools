# Android 17 conditional requirements (c/android-6.12/android-base-conditional.xml) that apply
# here: ARM64, ACPI=n, EXT4_FS=y, F2FS_FS=y, VMAP_STACK, AUTO_VAR_INIT_ZERO.
CONFIG_ARM64_PAN=y
CONFIG_ARM64_SW_TTBR0_PAN=y
CONFIG_ARMV8_DEPRECATED=y
CONFIG_CFI_CLANG=y
CONFIG_COMPAT=y
CONFIG_CP15_BARRIER_EMULATION=y
CONFIG_RANDOMIZE_BASE=y
CONFIG_SETEND_EMULATION=y
CONFIG_SHADOW_CALL_STACK=y
CONFIG_SWP_EMULATION=y
CONFIG_KFENCE=y
CONFIG_USERFAULTFD=y
CONFIG_OF=y
CONFIG_EXT4_FS=y
CONFIG_EXT4_FS_POSIX_ACL=y
CONFIG_F2FS_FS=y
CONFIG_F2FS_FS_POSIX_ACL=y
CONFIG_VMAP_STACK=y
CONFIG_INIT_STACK_ALL_ZERO=y
