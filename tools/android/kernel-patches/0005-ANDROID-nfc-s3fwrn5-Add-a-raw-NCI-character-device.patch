index a2ea546644bd..5d93be686ee0 100644
--- a/arch/arm64/configs/a3y17lte_defconfig
+++ b/arch/arm64/configs/a3y17lte_defconfig
@@ -243,6 +243,7 @@ CONFIG_RFKILL_INPUT=y
 CONFIG_NET_9P=y
 CONFIG_NFC=m
 CONFIG_NFC_NCI=m
+CONFIG_NFC_S3FWRN5_RAW=y
 CONFIG_NFC_S3FWRN5_I2C=m
 CONFIG_PAGE_POOL_STATS=y
 CONFIG_UEVENT_HELPER=y
diff --git a/drivers/nfc/s3fwrn5/Kconfig b/drivers/nfc/s3fwrn5/Kconfig
index 96386b73fa2b..cb56a7d15194 100644
--- a/drivers/nfc/s3fwrn5/Kconfig
+++ b/drivers/nfc/s3fwrn5/Kconfig
@@ -7,6 +7,17 @@ config NFC_S3FWRN5
 	  of chip. It's intended to be used by PHYs to avoid duplicating lots
 	  of common code.
 
+config NFC_S3FWRN5_RAW
+	bool "Samsung S3FWRN5 raw NCI character device"
+	depends on NFC_S3FWRN5
+	help
+	  Do not register the chip with the kernel's NCI core. /dev/s3fwrn5
+	  carries its NCI packets instead, for an NCI host in userspace
+	  (Android's NFC stack). The kernel NFC subsystem (neard, NFC
+	  sockets) cannot use the chip then.
+
+	  Say N if unsure.
+
 config NFC_S3FWRN5_I2C
 	tristate "Samsung S3FWRN5 I2C support"
 	depends on NFC_NCI && I2C
