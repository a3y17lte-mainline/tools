From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20=C5=A0trobl?= <recordyletsplays@gmail.com>
Date: Sun, 15 Nov 2026 01:32:33 +0100
Subject: [PATCH 10/11] ANDROID: power: supply: s2mu005-battery: Report
 presence and temperature

Android's health HAL looks for the battery's presence, temperature and
technology on the battery power supply; the gauge reported none of them.

Report the battery as present (the gauge has no detection, the battery
is built in) and, when the board gives the gauge the thermistor's IIO
channel ("batt-temp"), its temperature. The technology and the design
values come from the power supply core once the node has a
monitored-battery.

To go into the mainline series.
---
 .../supply/samsung,s2mu005-fuel-gauge.yaml    |  7 +++
 drivers/power/supply/s2mu005-battery.c        | 44 ++++++++++++++++++-
 2 files changed, 49 insertions(+), 2 deletions(-)

diff --git a/Documentation/devicetree/bindings/power/supply/samsung,s2mu005-fuel-gauge.yaml b/Documentation/devicetree/bindings/power/supply/samsung,s2mu005-fuel-gauge.yaml
index f83343283c08..4a512e49b866 100644
--- a/Documentation/devicetree/bindings/power/supply/samsung,s2mu005-fuel-gauge.yaml
+++ b/Documentation/devicetree/bindings/power/supply/samsung,s2mu005-fuel-gauge.yaml
@@ -26,6 +26,13 @@ properties:
   interrupts:
     maxItems: 1
 
+  io-channels:
+    maxItems: 1
+    description: Battery temperature, from the thermistor on an ADC input.
+
+  io-channel-names:
+    const: batt-temp
+
 required:
   - compatible
   - reg
diff --git a/drivers/power/supply/s2mu005-battery.c b/drivers/power/supply/s2mu005-battery.c
index 4a2d1f36ade5..ce1a2987a071 100644
--- a/drivers/power/supply/s2mu005-battery.c
+++ b/drivers/power/supply/s2mu005-battery.c
@@ -9,6 +9,7 @@
 
 #include <linux/delay.h>
 #include <linux/i2c.h>
+#include <linux/iio/consumer.h>
 #include <linux/interrupt.h>
 #include <linux/mod_devicetable.h>
 #include <linux/mutex.h>
@@ -38,6 +39,7 @@ struct s2mu005_fg {
 	struct device *dev;
 	struct regmap *regmap;
 	struct power_supply *psy;
+	struct iio_channel *batt_temp;
 	struct mutex monout_mutex;
 };
 
@@ -207,8 +209,26 @@ static const enum power_supply_property s2mu005_fg_properties[] = {
 	POWER_SUPPLY_PROP_CURRENT_AVG,
 	POWER_SUPPLY_PROP_CAPACITY,
 	POWER_SUPPLY_PROP_STATUS,
+	POWER_SUPPLY_PROP_PRESENT,
+	/* last: dropped when there is no battery temperature channel */
+	POWER_SUPPLY_PROP_TEMP,
 };
 
+static int s2mu005_fg_get_temp(struct s2mu005_fg *priv, int *value)
+{
+	int ret, temp;
+
+	/* milli-degrees Celsius */
+	ret = iio_read_channel_processed(priv->batt_temp, &temp);
+	if (ret < 0)
+		return ret;
+
+	/* tenths of a degree; temp can be negative, so no unsigned unit macros */
+	*value = temp / 100;
+
+	return 0;
+}
+
 static int s2mu005_fg_get_property(struct power_supply *psy,
 				   enum power_supply_property psp,
 				   union power_supply_propval *val)
@@ -228,6 +248,12 @@ static int s2mu005_fg_get_property(struct power_supply *psy,
 		return s2mu005_fg_get_capacity(priv, &val->intval);
 	case POWER_SUPPLY_PROP_STATUS:
 		return s2mu005_fg_get_status(priv, &val->intval);
+	case POWER_SUPPLY_PROP_PRESENT:
+		/* the gauge has no battery detection; the battery is built in */
+		val->intval = 1;
+		return 0;
+	case POWER_SUPPLY_PROP_TEMP:
+		return s2mu005_fg_get_temp(priv, &val->intval);
 	default:
 		return -EINVAL;
 	}
@@ -246,7 +272,7 @@ static int s2mu005_fg_i2c_probe(struct i2c_client *client)
 	struct device *dev = &client->dev;
 	struct s2mu005_fg *priv;
 	struct power_supply_config psy_cfg = {};
-	const struct power_supply_desc *psy_desc;
+	struct power_supply_desc *psy_desc;
 	int ret;
 
 	priv = devm_kzalloc(dev, sizeof(*priv), GFP_KERNEL);
@@ -265,7 +291,21 @@ static int s2mu005_fg_i2c_probe(struct i2c_client *client)
 	if (ret)
 		return dev_err_probe(dev, ret, "failed to initialize MONOUT mutex\n");
 
-	psy_desc = device_get_match_data(dev);
+	/* The battery thermistor, where the board has one on an ADC */
+	priv->batt_temp = devm_iio_channel_get(dev, "batt-temp");
+	if (IS_ERR(priv->batt_temp)) {
+		if (PTR_ERR(priv->batt_temp) != -ENODEV)
+			return dev_err_probe(dev, PTR_ERR(priv->batt_temp),
+					     "failed to get the temperature channel\n");
+		priv->batt_temp = NULL;
+	}
+
+	psy_desc = devm_kmemdup(dev, device_get_match_data(dev),
+				sizeof(*psy_desc), GFP_KERNEL);
+	if (!psy_desc)
+		return -ENOMEM;
+	if (!priv->batt_temp)
+		psy_desc->num_properties--;
 
 	psy_cfg.drv_data = priv;
 	psy_cfg.fwnode = dev_fwnode(dev);
