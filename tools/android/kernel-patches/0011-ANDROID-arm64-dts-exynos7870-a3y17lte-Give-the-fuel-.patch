From: =?UTF-8?q?Martin=20=C5=A0trobl?= <recordyletsplays@gmail.com>
Date: Sun, 15 Nov 2026 01:32:33 +0100
Subject: [PATCH 11/11] ANDROID: arm64: dts: exynos7870-a3y17lte: Give the fuel
 gauge the battery data

The battery description, for the technology and the design capacity, and
the battery thermistor for the temperature.

To go into the mainline series.
---
 arch/arm64/boot/dts/exynos/exynos7870-a3y17lte.dts | 4 ++++
 1 file changed, 4 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870-a3y17lte.dts b/arch/arm64/boot/dts/exynos/exynos7870-a3y17lte.dts
index 5bf0b33f5959..29f1b0efeb57 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870-a3y17lte.dts
+++ b/arch/arm64/boot/dts/exynos/exynos7870-a3y17lte.dts
@@ -784,6 +784,10 @@ fuel-gauge@3b {
 		interrupt-parent = <&gpa0>;
 		interrupts = <3 IRQ_TYPE_EDGE_FALLING>;
 
+		io-channels = <&battery_thermistor>;
+		io-channel-names = "batt-temp";
+		monitored-battery = <&battery>;
+
 		pinctrl-0 = <&fuel_irq>;
 		pinctrl-names = "default";
 	};
