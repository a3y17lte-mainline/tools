#!/usr/bin/python3 -I
"""Claude Code PreToolUse hook (Bash): block any command that could write to the phone's
eMMC except through a3-flash. Reads the hook JSON on stdin; exits 2 (block) on a match.

Read-only operations stay allowed: heimdall detect / print-pit / download-pit,
adb devices / get-state / pull / shell reads, a3-backup.
"""
import json, re, sys

try:
    cmd = json.load(sys.stdin).get("tool_input", {}).get("command", "")
except Exception:
    sys.exit(0)

RULES = [
    (r"\bheimdall\b[^|;&\n]*\b(flash|close-pc-screen)\b", "raw heimdall flash (use a3-flash)"),
    (r"--repartition\b", "repartitioning"),
    (r"--tflash\b", "heimdall T-Flash mode"),
    (r"(^|[;&|(]|\bsudo|\benv|\bexec)\s*(\S*/)?odin4?(\s|$)", "odin flasher (use a3-flash)"),
    # "fastboot boot" only loads an image into RAM (user-approved 2026-11-08); writes stay blocked
    (r"\bfastboot\b[^|;&\n]*(\b(flash|erase|format|oem|flashing|update|wipe)\b|\s-w\b)", "fastboot write"),
    (r"\badb\b[^|;&\n]*\bsideload\b", "adb sideload"),
    (r"\bof=\s*['\"]?/dev/(block/)?(mmcblk|sd[a-z]|by-name|platform|loop)", "dd to a block device"),
    (r"/dev/block/[^\s'\"]*by-name/[A-Za-z0-9_]+[^|;&\n]*(>|\btee\b)", "write to a by-name partition"),
    (r">\s*['\"]?/dev/(block/)?(mmcblk|sd[a-z])", "redirect into a block device"),
    (r"\bblockdev\b[^|;&\n]*--setrw\b", "making a block device writable"),
    (r"force_ro", "touching eMMC boot-area force_ro"),
    (r"\b(mkfs(\.\w+)?|mke2fs|make_ext4fs|sgdisk|gdisk|parted|fdisk|sfdisk|wipefs|flash_image|erase_image|mmc\s+(write|erase|bootpart|partconf|writeprotect|extcsd\s+write))\b"
     r"[^|;&\n]*(/dev/(block/)?(mmcblk|sd[a-z])|by-name)", "partitioning/formatting a phone block device"),
    (r"\btwrp\b[^|;&\n]*\b(wipe|format|install|restore)\b", "TWRP write command"),
    # S2MU004 charger/fuel gauge/PD: userspace I2C writes need the user's yes (2026-11-08);
    # i2cdetect probes with quick writes. i2cget reads stay allowed.
    (r"\bi2c(set|transfer|detect)\b", "I2C write/probe (i2cset/i2ctransfer/i2cdetect)"),
]

for pat, why in RULES:
    if re.search(pat, cmd, re.IGNORECASE):
        print(f"BLOCKED by guard-phone-writes: {why}. Flash only via a3-flash; "
              f"ask the user if this is really needed.", file=sys.stderr)
        sys.exit(2)
sys.exit(0)
