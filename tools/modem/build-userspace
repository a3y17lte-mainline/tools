#!/bin/bash
# build-userspace: cross-build the open modem userspace for the phone's Alpine (aarch64, musl):
# libsamsung-ipc (our Shannon fork, src/libsamsung-ipc), its ipc-modem test tool, and
# samsungipcd (AT command proxy for ModemManager/oFono, + an NV request service).
#
#   build-userspace [--nv-dir DIR] [--out DIR]
#
# Sources: src/libsamsung-ipc (own repo, branch a3y17lte; the device is found at run time from
# the device tree) and work/ref/samsungipcd, cloned at the pinned commit with
# tools/modem/patches/samsungipcd applied on a branch "a3y17lte" if it is missing.
# Output: out/modem-userspace/ (a tree to copy onto the rootfs; nothing is installed here).
# With src/shannond present it also cross-builds shannond (usr/sbin/shannond; the sysroot needs g++ and
# libstdc++-dev, added with the same apk call as below).
#
# --nv-dir: where the modem's NV data files live on the phone (default /var/lib/modem/nv, a
# working copy). /efs is the real thing: only with the user's yes, see work/notes/modem.md.
# --out: build somewhere else than out/modem-userspace (used by test-nv).
#
# The host has no autotools, so the sources are compiled directly with clang against an
# Alpine sysroot (out/modem-sysroot, made with the initramfs' static apk).
set -euo pipefail
ROOT=~/Projects/exynos7870
REF=$ROOT/work/ref
SYSROOT=$ROOT/out/modem-sysroot
OUT=$ROOT/out/modem-userspace
PATCHES=$ROOT/tools/modem/patches
NV_DIR=/var/lib/modem/nv
DAEMON_URL=https://github.com/manoedinata/samsungipcd
DAEMON_COMMIT=7165a7481ac1a943f73e32f39e3e2d50e5507d5c

while [ $# -gt 0 ]; do
	case $1 in
	--nv-dir) NV_DIR=$2; shift 2 ;;
	--out) OUT=$2; shift 2 ;;
	*) echo "usage: build-userspace [--nv-dir DIR] [--out DIR]" >&2; exit 2 ;;
	esac
done

fetch() { # name url commit
	local dir=$REF/$1
	[ -d "$dir" ] && return 0
	git clone -q "$2" "$dir"
	git -C "$dir" checkout -q -b a3y17lte "$3"
	git -C "$dir" am -q "$PATCHES/$1"/*.patch
}

if [ ! -e "$SYSROOT/usr/lib/crt1.o" ]; then
	mkdir -p "$SYSROOT/etc/apk"
	cp -r "$ROOT/work/initramfs/etc/apk/keys" "$ROOT/work/initramfs/etc/apk/repositories" "$SYSROOT/etc/apk/"
	(cd "$ROOT/work/initramfs" && qemu-aarch64-static -L . ./sbin/apk --root "$SYSROOT" --usermode \
		--arch aarch64 --initdb --no-scripts add musl-dev openssl-dev gcc g++ libstdc++-dev linux-headers)
fi

fetch samsungipcd $DAEMON_URL $DAEMON_COMMIT

CC=(clang --target=aarch64-alpine-linux-musl --sysroot="$SYSROOT" -fuse-ld=lld -O2 -g0 -Wall
	-Wno-unused-parameter)
LIB=$ROOT/src/libsamsung-ipc
[ -d "$LIB" ] || { echo "build-userspace: $LIB is missing" >&2; exit 1; }
DAEMON=$REF/samsungipcd

rm -rf "$OUT"
mkdir -p "$OUT/usr/lib" "$OUT/usr/bin" "$OUT/usr/sbin" "$OUT/usr/include/samsung-ipc"

mapfile -t SRCS < <(find "$LIB/samsung-ipc" -name '*.c' -not -path '*/tests/*' | sort)
"${CC[@]}" -shared -fPIC -Wl,-soname,libsamsung-ipc.so.0 -o "$OUT/usr/lib/libsamsung-ipc.so.0" \
	-I"$LIB/include" -I"$LIB/samsung-ipc" \
	-DIPC_NV_DATA_DIR="\"$NV_DIR\"" \
	"${SRCS[@]}" -lcrypto
ln -s libsamsung-ipc.so.0 "$OUT/usr/lib/libsamsung-ipc.so"
cp "$LIB"/include/*.h "$OUT/usr/include/samsung-ipc/"

LINK=(-I"$OUT/usr/include/samsung-ipc" -L"$OUT/usr/lib" -lsamsung-ipc -lpthread)
"${CC[@]}" -o "$OUT/usr/bin/ipc-modem" "$LIB"/tools/ipc-modem/ipc-modem.c \
	"$LIB"/tools/ipc-modem/ipc-modem-log.c "${LINK[@]}"
"${CC[@]}" -o "$OUT/usr/bin/nv_data-md5" "$LIB"/tools/nv_data-md5.c "${LINK[@]}"
"${CC[@]}" -DPREFIX='"/usr"' -o "$OUT/usr/sbin/samsungipcd" "$DAEMON"/server.c "$DAEMON"/ppp_crc.c \
	"$DAEMON"/samsung-ipc.c "${LINK[@]}"

# shannond (src/shannond, own repo): the open modem daemon, if it is there
SHANNOND=$ROOT/src/shannond
if [ -d "$SHANNOND" ]; then
	MB=$ROOT/out/shannond-aarch64
	cmake -S "$SHANNOND" -B "$MB" -G Ninja -DCMAKE_BUILD_TYPE=Release \
		-DCMAKE_TOOLCHAIN_FILE="$SHANNOND/cmake/alpine-aarch64.cmake" -DALPINE_SYSROOT="$SYSROOT" \
		-DLIBSAMSUNG_IPC_DIR="$LIB" > /dev/null
	ninja -C "$MB" shannond > /dev/null
	install -m755 "$MB/shannond" "$OUT/usr/sbin/shannond"
fi

{
	echo "libsamsung-ipc $(git -C "$LIB" rev-parse --short HEAD)"
	echo "samsungipcd $(git -C "$DAEMON" rev-parse --short HEAD) (base ${DAEMON_COMMIT:0:7})"
	[ -d "$SHANNOND" ] && echo "shannond $(git -C "$SHANNOND" rev-parse --short HEAD 2>/dev/null || echo uncommitted)"
	echo "NV data directory: $NV_DIR"
} > "$OUT/BUILD-INFO"
find "$OUT" -type f | sort | sed "s|$OUT/||"
