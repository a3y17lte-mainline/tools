From 749a2b5851916284a987bb30478e928fd509a596 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20=C5=A0trobl?= <recordyletsplays@gmail.com>
Date: Mon, 16 Nov 2026 10:19:58 +0100
Subject: [PATCH 5/7] herolte: Declare the transport functions in the header

So that a device with the same modem can fall back to them.
---
 samsung-ipc/devices/herolte/herolte.h | 16 ++++++++++++++++
 1 file changed, 16 insertions(+)

diff --git a/samsung-ipc/devices/herolte/herolte.h b/samsung-ipc/devices/herolte/herolte.h
index 9294a86..b4ecf4a 100644
--- a/samsung-ipc/devices/herolte/herolte.h
+++ b/samsung-ipc/devices/herolte/herolte.h
@@ -22,10 +22,26 @@
 #ifndef __HEROLTE_H__
 #define __HEROLTE_H__
 
+#include <stddef.h>
+#include <sys/time.h>
+
+#include <samsung-ipc.h>
+
 struct herolte_transport_data {
 	int fd;
 };
 
+int herolte_boot(struct ipc_client *client);
+int herolte_open(struct ipc_client *client, void *data, int type);
+int herolte_close(struct ipc_client *client, void *data);
+int herolte_read(struct ipc_client *client, void *data, void *buffer,
+		 size_t length);
+int herolte_write(struct ipc_client *client, void *data, const void *buffer,
+		  size_t length);
+int herolte_poll(struct ipc_client *client, void *data,
+		 struct ipc_poll_fds *fds, struct timeval *timeout);
+int herolte_power_off(struct ipc_client *client, void *data);
+
 extern struct ipc_client_ops herolte_fmt_ops;
 extern struct ipc_client_ops herolte_rfs_ops;
 extern struct ipc_client_handlers herolte_handlers;
