#!/bin/bash
# test-nv: check on the host that libsamsung-ipc's a3y17lte profile accepts the phone's NV data
# files as they are: no "restore" from the 2019 backup file, no rewrite, and that an NV write
# only touches the bytes it is given plus the md5 file.
#
#   test-nv [BACKUP_DIR]
#
# Works on a scratch copy of the four NV files taken from the EFS backup image (read-only use
# of the backup; the copy is deleted at the end, it holds the IMEI and calibration).
set -euo pipefail
ROOT=~/Projects/exynos7870
BACKUP=${1:-$(ls -d "$ROOT"/backups/2*/ | tail -1)}
SYSROOT=$ROOT/out/modem-sysroot
T=$(mktemp -d)
trap 'rm -rf "$T"' EXIT
NV=$T/nv
mkdir -p "$NV"

for f in nv_data.bin nv_data.bin.md5 .nv_data.bak .nv_data.bak.md5; do
	debugfs -R "dump /$f $NV/$f" "$BACKUP/EFS.img" 2>/dev/null
	[ -s "$NV/$f" ] || { echo "FAIL: $f not in $BACKUP/EFS.img"; exit 1; }
done
(cd "$NV" && sha256sum nv_data.bin nv_data.bin.md5 .nv_data.bak .nv_data.bak.md5) > "$T/before"

"$ROOT/tools/modem/build-userspace" --nv-dir "$NV" --out "$T/out" > /dev/null 2>&1

cat > "$T/test.c" <<'EOT'
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <samsung-ipc.h>

static void log_cb(void *data, const char *msg)
{
	printf("  lib: %s\n", msg);
}

int main(void)
{
	struct ipc_client *client = ipc_client_create(IPC_CLIENT_TYPE_RFS);
	void *all, *part;
	int fail = 0;

	if (!client) {
		printf("FAIL: no client (device profile not found)\n");
		return 1;
	}
	ipc_client_log_callback_register(client, log_cb, NULL);

	printf("NV size %#zx, path %s\n", ipc_client_nv_data_size(client),
	       ipc_client_nv_data_path(client));

	if (ipc_nv_data_check(client) < 0) {
		printf("FAIL: nv_data check\n");
		fail = 1;
	}
	if (ipc_nv_data_backup_check(client) < 0) {
		printf("FAIL: nv_data backup check\n");
		fail = 1;
	}

	all = ipc_nv_data_load(client);
	if (!all) {
		printf("FAIL: nv_data load\n");
		return 1;
	}

	/* An NV item write of the bytes that are there already */
	part = ipc_nv_data_read(client, 0x40, 0x1000);
	if (!part || memcmp(part, (char *)all + 0x1000, 0x40)) {
		printf("FAIL: nv_data read\n");
		fail = 1;
	} else if (ipc_nv_data_write(client, part, 0x40, 0x1000) < 0) {
		printf("FAIL: nv_data write\n");
		fail = 1;
	}

	return fail;
}
EOT
clang --target=aarch64-alpine-linux-musl --sysroot="$SYSROOT" -fuse-ld=lld -O1 -o "$T/test" "$T/test.c" \
	-I"$T/out/usr/include/samsung-ipc" -L"$T/out/usr/lib" -lsamsung-ipc

rc=0
# No device tree on the host: name the device
qemu-aarch64-static -L "$SYSROOT" -E LD_LIBRARY_PATH="$T/out/usr/lib" \
	-E LIBSAMSUNG_IPC_DEVICE=a3y17lte "$T/test" || rc=$?
(cd "$NV" && sha256sum nv_data.bin nv_data.bin.md5 .nv_data.bak .nv_data.bak.md5) > "$T/after"

if ! cmp -s "$T/before" "$T/after"; then
	echo "FAIL: the library changed the NV files:"
	diff "$T/before" "$T/after" | sed 's/^\(.\) [0-9a-f]\{64\}/\1/' || true
	rc=1
fi
[ "$rc" = 0 ] && echo "PASS: NV files accepted and unchanged" || echo "FAILED"
exit "$rc"
