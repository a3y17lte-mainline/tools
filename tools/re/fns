#!/usr/bin/env python3
"""Print functions from a DumpDecomp.java dump with PIC string references resolved.

Usage: fns LIB DIR REGEX
Like `fn DIR REGEX`, but every `DAT_xxx + 0xyyy` that points at a printable string in
LIB is followed by the string as a comment. Log calls are kept: their format strings
name the fields."""
import glob
import re
import subprocess
import sys

lib, d, pat = sys.argv[1], sys.argv[2], re.compile(sys.argv[3])
data = open(lib, "rb").read()
segs = []
for line in subprocess.run(["readelf", "-lW", lib], capture_output=True, text=True,
                           check=True).stdout.splitlines():
    f = line.split()
    if f and f[0] == "LOAD":
        segs.append((int(f[2], 16), int(f[1], 16), int(f[4], 16)))


def off(va):
    for vaddr, o, size in segs:
        if vaddr <= va < vaddr + size:
            return va - vaddr + o
    return None


def resolve(m):
    o = off(int(m.group(1), 16))
    if o is None:
        return m.group(0)
    lit = int.from_bytes(data[o:o + 4], "little", signed=True)
    so = off((lit + int(m.group(2), 16)) & 0xffffffff)
    if so is None:
        return m.group(0)
    s = data[so:so + 200].split(b"\0", 1)[0]
    if not s or any(c < 0x20 and c not in (9, 10, 13) or c > 0x7e for c in s):
        return m.group(0)
    return '%s /*"%s"*/' % (m.group(0), s.decode().replace("*/", "* /"))


expr = re.compile(r"DAT_([0-9a-f]+) \+ (0x[0-9a-f]+)")
for path in sorted(glob.glob(d + "/*.c")):
    show = False
    for line in open(path, errors="replace"):
        if line.startswith("// ==== "):
            show = bool(pat.search(line))
        if show:
            sys.stdout.write(expr.sub(resolve, line))
