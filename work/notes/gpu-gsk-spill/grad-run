#!/bin/sh
# usage: grad-run <w> <h> [ENV=val ...]   show a WxH gradient box on the phone, print spill errors and new GPU faults/timeouts
w=$1; h=$2; shift 2
exec "$(dirname "$0")/pm" "f0=\$(dmesg | grep -c 'js fault'); t0=\$(dmesg | grep -c 'sched timeout'); env XDG_RUNTIME_DIR=/run/user/\$(id -u) WAYLAND_DISPLAY=wayland-0 MESA_SHADER_CACHE_DISABLE=true $* timeout 12 python3 /home/user/mesa-test/grad.py $w $h > /tmp/grad.log 2>&1; echo \"spill errors=\$(grep -c 'spill node' /tmp/grad.log) new faults=\$((\$(dmesg | grep -c 'js fault')-f0)) new timeouts=\$((\$(dmesg | grep -c 'sched timeout')-t0)) \$(grep -v '^\$' /tmp/grad.log | grep -v 'spill node' | tail -1 | cut -c1-120)\""
