From a8decabbd116a8b099598c2808f7dbc27b2cb377 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Martin=20=C5=A0trobl?= <recordyletsplays@gmail.com>
Date: Tue, 10 Nov 2026 22:48:49 +0100
Subject: [PATCH] gpu: Only supersample linear gradients where it changes the
 result

The supersampled linear gradient shader evaluates the gradient four
times per pixel. Where all four samples fall between the same two color
stops, without a transition hint or a repeat boundary in between, the
gradient is linear over them, and since they are placed symmetrically
around the pixel center their average is the color at the center.

Check that first and take one sample in that case. Pixels near stops,
hints and repeat boundaries still get four samples, so hard stops stay
antialiased.

On a Mali-T830 (Panfrost) a full-window gradient goes from 55 ms to
32 ms per frame.
---
 gsk/gpu/shaders/gskgpulineargradient.glsl | 49 ++++++++++++++++++++++-
 1 file changed, 48 insertions(+), 1 deletion(-)

diff --git a/gsk/gpu/shaders/gskgpulineargradient.glsl b/gsk/gpu/shaders/gskgpulineargradient.glsl
index 7866927..6fecab4 100644
--- a/gsk/gpu/shaders/gskgpulineargradient.glsl
+++ b/gsk/gpu/shaders/gskgpulineargradient.glsl
@@ -214,6 +214,48 @@ get_gradient_color_at (float offset)
   return output_color_from_alt (get_gradient_color (offset));
 }
 
+/* Whether the gradient is a straight line between offsets lo and hi: no
+ * color stop, no repeat boundary and no transition hint in between. The
+ * supersamples are placed symmetrically around the pixel center, so in that
+ * case their average is the color at the center. */
+bool
+is_linear_between (float lo,
+                   float hi)
+{
+  if (any (notEqual (_hints0.yzw, vec3 (0.5))) ||
+      any (notEqual (_hints1.xyz, vec3 (0.5))))
+    return false;
+
+  if (VARIATION_REPEAT == GSK_REPEAT_REPEAT ||
+      VARIATION_REPEAT == GSK_REPEAT_REFLECT)
+    {
+      float period = floor (lo);
+
+      if (period != floor (hi))
+        return false;
+
+      lo -= period;
+      hi -= period;
+
+      if (VARIATION_REPEAT == GSK_REPEAT_REFLECT && int (period) % 2 != 0)
+        {
+          float t = lo;
+          lo = 1.0 - hi;
+          hi = 1.0 - t;
+        }
+    }
+
+  /* The ends of the gradient are boundaries for the other repeat modes */
+  if ((lo <= 0.0 && hi >= 0.0) || (lo <= 1.0 && hi >= 1.0))
+    return false;
+
+  float mid = 0.5 * (lo + hi);
+  float half_width = 0.5 * (hi - lo);
+
+  return !any (lessThanEqual (abs (_offsets0 - mid), vec4 (half_width))) &&
+         !any (lessThanEqual (abs (_offsets1.xyz - mid), vec3 (half_width)));
+}
+
 void
 run (out vec4 color,
      out vec2 position)
@@ -224,7 +266,12 @@ run (out vec4 color,
     {
       float dx = 0.25 * dFdx (_offset);
       float dy = 0.25 * dFdy (_offset);
-      color = output_color_alpha (get_gradient_color_at (_offset - dx - dy) +
+      float r = abs (dx) + abs (dy);
+
+      if (is_linear_between (_offset - r, _offset + r))
+        color = output_color_alpha (get_gradient_color_at (_offset), alpha);
+      else
+        color = output_color_alpha (get_gradient_color_at (_offset - dx - dy) +
                                   get_gradient_color_at (_offset - dx + dy) +
                                   get_gradient_color_at (_offset + dx - dy) +
                                   get_gradient_color_at (_offset + dx + dy),
